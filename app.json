
{
  "expo": {
    "name": "Alfinete",
    "slug": "alfinete-app",
    "scheme": "alfineteapp",
    "owner": "allanmsilva23",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alfinete.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6fe7cd",
        "foregroundImage": "./assets/images/alfineteLogoAndroid.png",
        "backgroundImage": "./assets/images/backgroundAlfineteLogoAndroid.png",
        "monochromeImage": "./assets/images/alfineteLogoBWAndroid.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alfinete.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6fe7cd",
          "dark": {
            "backgroundColor": "#6fe7cd"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fbd7de61-d612-4bde-b404-537f917f3805"
      }
    }
  }
}